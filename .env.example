# Google Maps JavaScript API key (Maps JavaScript API must be enabled)
# Restrict by HTTP referrer (localhost + production domain). API restriction: Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Preferred server-only Places API (New) key for autocomplete + place details.
# IP-restricted in production (see PR-10 — Things left to do). Unrestricted is OK for local/dev.
# Falls back to GOOGLE_GEOCODING_API_KEY, then Maps key for local.
# GOOGLE_PLACES_API_KEY=
# Preferred server-only Geocoding key (IP-restricted in production; falls back to Maps key for local)
# GOOGLE_GEOCODING_API_KEY=

# Supabase (hosted project — see docs/developer/supabase.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase docs (code falls back from this to ANON_KEY)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Public site origin for auth email redirects (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Server only — OpenAI for admin tag suggest / alias backfill
OPENAI_API_KEY=

# TinaCMS / TinaCloud (also set these in the Vercel project env)
NEXT_PUBLIC_TINA_CLIENT_ID=
# Server only — never expose to the browser
TINA_TOKEN=

# PostHog (Cloud EU) — optional product analytics + session replay.
# Use separate project API keys for local/dev vs production.
# Omit NEXT_PUBLIC_POSTHOG_KEY locally to disable the SDK (no-op provider).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry — always-on essential error monitoring (independent of PostHog consent).
# Use Sentry EU (https://de.sentry.io) with separate projects for local/dev vs production.
# DSNs look like https://…@….ingest.de.sentry.io/…
# Omit DSN locally to disable the SDK.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only alias; client uses NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# Optional override: development | preview | production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time source map upload (CI / Vercel only — never commit the token).
# Auth token scopes: Release Admin, Organization Read, Project Read —
# leave Issue/Event, Team, Member, Alerts as No Access.
# https://de.sentry.io/settings/{org}/auth-tokens/
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

